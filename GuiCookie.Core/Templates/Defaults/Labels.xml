<?xml version="1.0" encoding="utf-8" ?>
<Main>
  <Templates>

    <!--Numbers-->
    <NumberCounter Controller="NumberCounter" Components="DirectionalLayout">
      <TextButton Size="100%, 33%" Text="+" Name="IncrementButton"/>
      <TextBox Size="100%, 33%" Name="Label"/>
      <TextButton Size="100%, 33%" Text="-" Name="DecrementButton"/>
    </NumberCounter>

    <!--Boxes and labels-->
    <TextBox Components="StyleStateMachine, Frame, TextBlock" Controller="TextBox"/>
    <ImageBox Components="StyleStateMachine, Frame, ImageBlock" Controller="ImageBox"/>
    <BoxIcon Components="StyleStateMachine, Frame, ImageBlock, AspectRatioFitter" Controller="ImageBox" ClippingMode="Squeeze" Ratio="1" RatioMode="WidthControlsHeight"/>

    <TextLabel Components="StyleStateMachine, TextBlock" Controller="TextBox"/>
    <ImageLabel Components="StyleStateMachine, ImageBlock" Controller="ImageBox"/>
    <LabelIcon Components="StyleStateMachine, ImageBlock, AspectRatioFitter" Controller="ImageBox" ClippingMode="Squeeze" Ratio="1" RatioMode="WidthControlsHeight"/>
  </Templates>
</Main>
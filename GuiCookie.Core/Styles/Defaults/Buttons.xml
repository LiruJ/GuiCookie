<?xml version="1.0" encoding="utf-8" ?>
<Main>
  <Styles>

    <Button>
      <SliceFrame Image="Button" NineSlice="Thirds" Colour="$GuiCookiePrimaryColour" Tint="$MainTint" ShadowOffset="-2, 2" ShadowColour="#0002"/>
      <Font Font="Default" Colour="GuiCookieOnPrimaryColour" ShadowOffset="-1"/>
      
      <Hovered>
        <SliceFrame Tint="#FFF"/>
        <Font Tint="#FFF"/>
      </Hovered>
      <Clicked>
        <SliceFrame Image="ButtonPressed" Tint="$ClickedTint"/>
        <Font Tint="$ClickedTint" Offset="0, 2"/>
      </Clicked>
      <Disabled>
        <SliceFrame Image="ButtonPressed" Tint="$DisabledTint"/>
        <Font Tint="$DisabledTint" Offset="0, 2"/>
      </Disabled>
    </Button>
  </Styles>
</Main>
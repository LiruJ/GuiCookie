<?xml version="1.0" encoding="utf-8" ?>
<Main>

  <Templates>
    <!--Lists-->
    <ListPane Components="Frame, DirectionalLayout" Controller="ListPane"/>
    <TestListItem Controller="TestListItem" Size="100%, 15">
      <TextBox Name="Key" Size="70%, 100%" TextAnchor="5%, 50%" TextPivot="0%, 50%" ShadowOffset="-1" Style="Inlay"/>
      <TextBox Name="Value" Size="25%, 100%" Position="70%, 0%" TextAnchor="5%, 50%" TextPivot="0%, 50%" Style="Inlay"/>
      <TextButton Name="RemoveButton" Size="5%, 100%" Position="95%, 0%" Style="RemoveButton"/>
    </TestListItem>

    <TestDraggable Components="Frame, Draggable, TextBlock"/>
    <DropTest Components="Frame, DropTarget, GridLayout"/>

    <!--Indicators-->
    <IndicatorLight Components="StyleStateMachine, Light, AspectRatioFitter" AspectRatioMode="HeightControlsWidth" AspectRatio="1" Controller="IndicatorLight"/>

    <ButtonWithLight Components="DirectionalLayout" Size="100%, 24" LayoutDirection="Horizontal" Controller="ButtonWithLight">
      <TextButton Size="90%, 100%"/>
      <IndicatorLight Size="10%, 100%" LightImage="Light" Timer="0.5" LightColour="$IndicatorColour" LightOffColour="$IndicatorOffColour" LightFrameStyle="Image" LightFrameImage="LightFrame"/>
    </ButtonWithLight>
  </Templates>
</Main>
<?xml version="1.0" encoding="utf-8" ?>
<Layout>
  <StyleSheets RootFolder="Content/Gui/Styles">
    <StyleSheet Source="TestStyle"/>
  </StyleSheets>
  <TemplateSheets RootFolder="Content/Gui/Templates">
    <TemplateSheet Source="TestTemplates"/>
  </TemplateSheets>

  <Root Padding="5">
    <StackPartition Position="0, 0" Size="100%" LayoutDirection="Vertical" Spacing="1%">
      <StackPartition Name="TabButtons" Position="0, 0" Size="100%, 5%">
        <TextButton Size="80, 100%" Text="Buttons"/>
      </StackPartition>

      <Pane Name="TabContent" Size="100%, 94%" Padding="5" Tint="#555">
        <StackPartition Name="ButtonsTab" Size="100%">
          <!--ClickType examples-->
          <StackPanel Size="17.5%, 20%" LayoutDirection="Vertical" Spacing="5" Padding="5">
            <TextLabel Size="100%, 24" Text="ClickType"/>
            <StackPartition Size="100%, 100%" LayoutDirection="Vertical" Spacing="5">
              <ButtonWithLight Text="OnMouseDown" ClickType="OnMouseDown"/>
              <ButtonWithLight Text="OnMouseUp" ClickType="OnMouseUp"/>
            </StackPartition>
          </StackPanel>
        </StackPartition>
      </Pane>
    </StackPartition>
  </Root>
</Layout>
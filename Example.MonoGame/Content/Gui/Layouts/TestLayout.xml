<?xml version="1.0" encoding="utf-8" ?>
<Layout>
  <StyleSheets RootFolder="Content/Gui/Styles">
    <StyleSheet Source="TestStyle"/>
  </StyleSheets>
  <TemplateSheets RootFolder="Content/Gui/Templates">
    <TemplateSheet Source="TestTemplates"/>
  </TemplateSheets>

  <Root Padding="10">
    <StackPanel Position="0, 0" Size="100%" LayoutDirection="Vertical" Spacing="1%">
      <StackPanel Name="TabButtons" Position="0, 0" Size="100%, 5%">
        <TextButton Size="80, 100%" Text="Test"/>
      </StackPanel>

      <Pane Name="TabContent" Size="100%, 94%" Padding="5" Tint="#555">
        <StackPanel Name="ButtonsTab" Size="100%">
          <!--ClickType examples-->
          <StackPanel Size="25%, 100%" LayoutDirection="Vertical" Spacing="5">
            <TextButton Size="50%, 24" Text="ClickType.OnMouseDown" ClickType="OnMouseDown"/>
            <TextButton Size="50%, 24" Text="ClickType.OnMouseUp" ClickType="OnMouseUp"/>
          </StackPanel>
        </StackPanel>
      </Pane>
    </StackPanel>
  </Root>
</Layout>